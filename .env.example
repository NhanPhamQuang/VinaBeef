# Copy to .env. The launcher loads it automatically; DO NOT COMMIT .env
APP_ENV=development
DEMO_MODE=1
# Local-only demo secrets; replace in any shared/public installation.
JWT_SECRET=vinabeef-LOCAL-DEMO-ONLY-do-not-use-in-production
GATEWAY_API_KEY=vinabeef-local-gateway-demo-key
# For Aiven set your own rotated credentials. Do not use an existing Spring Boot schema.
# DATABASE_URL=postgresql+psycopg://username:NEW_PASSWORD@HOST:PORT/NEW_DATABASE?sslmode=require
# If you only want a quick local smoke-test, omit DATABASE_URL to use SQLite.
CENTRAL_API_URL=http://127.0.0.1:8000
EDGE_DB_PATH=./data/edge_events.sqlite
GATEWAY_ID=daklak-edge-01
SYNC_INTERVAL_SECONDS=10
